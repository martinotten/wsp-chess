#!/bin/sh
# Startet den Rust-Kern (engine-rs) als UCI-Engine; baut ihn bei Bedarf.
# Gewichte: weights/weights.bin (python export_rs.py). Fehler und Build-Ausgaben landen in logs/uci-rs.log.
DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/engine-rs/target/release/wsp-chess"
LOG="$DIR/logs/uci-rs.log"
if [ ! -x "$BIN" ]; then
  CARGO="$(command -v cargo 2>/dev/null)"
  [ -x "$CARGO" ] || CARGO=/opt/homebrew/bin/cargo
  [ -x "$CARGO" ] || CARGO="$HOME/.cargo/bin/cargo"
  (cd "$DIR/engine-rs" && "$CARGO" build --release) >> "$LOG" 2>&1
fi
exec "$BIN" 2>> "$LOG"
