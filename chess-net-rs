#!/bin/sh
# Startet den Rust-Kern als UCI-Engine; baut ihn bei Bedarf.
# Gewichte: weights/weights.bin. Fehler und Build-Ausgaben landen in logs/uci-rs.log.
DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/target/release/wsp-chess"
LOG="$DIR/logs/uci-rs.log"
mkdir -p "$DIR/logs"
if [ ! -x "$BIN" ]; then
  CARGO="$(command -v cargo 2>/dev/null)"
  [ -x "$CARGO" ] || CARGO=/opt/homebrew/bin/cargo
  [ -x "$CARGO" ] || CARGO="$HOME/.cargo/bin/cargo"
  (cd "$DIR" && "$CARGO" build --release) >> "$LOG" 2>&1
fi
exec "$BIN" 2>> "$LOG"
