#!/bin/sh
# Starts the Rust core as a UCI engine; builds it if needed.
# Weights: weights/weights.bin. Errors and build output go to logs/uci-rs.log.
DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/target/release/wsp-chess"
LOG="$DIR/logs/uci-rs.log"
mkdir -p "$DIR/logs"
if [ ! -x "$BIN" ]; then
  CARGO="$(command -v cargo 2>/dev/null)"
  [ -x "$CARGO" ] || CARGO=/opt/homebrew/bin/cargo
  [ -x "$CARGO" ] || CARGO="$HOME/.cargo/bin/cargo"
  (cd "$DIR" && "$CARGO" build --release) >> "$LOG" 2>&1
fi
exec "$BIN" 2>> "$LOG"
